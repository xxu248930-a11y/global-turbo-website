
name: Build Product Index

on:
  push:
    branches:
      - main
    paths:
      - 'products/**'
      - '.github/workflows/build-product-index.yml'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Generate product index
        run: |
          node <<'NODE'
          const fs = require("fs");
          const path = require("path");

          const products = [];

          function scan(dir) {
            if (!fs.existsSync(dir)) return;

            for (const item of fs.readdirSync(dir, { withFileTypes: true })) {
              const file = path.join(dir, item.name);

              if (item.isDirectory()) {
                scan(file);
              } else if (item.isFile() && item.name.endsWith(".json")) {
                try {
                  const data = JSON.parse(fs.readFileSync(file, "utf8"));

                  if (data && typeof data === "object" && !Array.isArray(data)) {
                    products.push(data);
                    console.log("Added:", file);
                  }
                } catch (error) {
                  console.log("Skipped invalid JSON:", file);
                }
              }
            }
          }

          scan("products");

          fs.writeFileSync(
            "products-index.json",
            JSON.stringify(products, null, 2) + "\n"
          );

          console.log("TOTAL PRODUCTS:", products.length);
          NODE

      - name: Save generated index
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add -f products-index.json

          if git diff --cached --quiet; then
            echo "Product index is already up to date."
          else
            git commit -m "Automatically update product index"
            git push
          fi


